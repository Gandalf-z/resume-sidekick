{
  "manifest_version": 3,
  "name": "求职随身简历",
  "version": "1.3.0",
  "description": "本地简历资料管理、PDF 解析与 OpportunityRadar 职业事实库同步。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "打开求职随身简历"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.worker.mjs",
        "lib/cmaps/*",
        "lib/standard_fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ]
}
